# Raw input data (large, downloaded/regenerable - not redistributed via git)
HFD/data/
ONS/data/
resolution/data/
OWID/data/
democracy/data/
eurostat/data/
GSS/data/
HCMST/data/
housing/data/
ILO/data/
FT/data/
UN/data/
NSO/data/
ACS/data/

# Sphinx docs build output (regenerated by every docs build, local or hosted)
docs/_build/

# Copies of */outputs/ that docs/conf.py mirrors into docs/_static/<source>/ at
# build time (not duplicated in git). Only subfolders are ignored, so tracked
# files directly in docs/_static/ (.gitkeep, factor-graph.html) stay tracked.
docs/_static/*/

# Python
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# pixi environment (regenerated from pixi.toml/pixi.lock)
.pixi/

# Office lock files
**/.~lock.*
DHS/data/
sources/.cache/
