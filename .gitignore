# Raw input data (large, downloaded/regenerable - not redistributed via git)
HFD/data/
ONS/data/
resolution/data/
OWID/data/
eurostat/data/
housing/data/

# Sphinx docs build output (regenerated by Netlify/local build)
docs/_build/

# Sphinx static assets copied in from */outputs/ at build time (not duplicated in git)
docs/_static/hfd/
docs/_static/ons/
docs/_static/resolution/
docs/_static/owid/
docs/_static/democracy/
docs/_static/eurostat/
docs/_static/housing/

# Python
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# pixi environment (regenerated from pixi.toml/pixi.lock)
.pixi/

# Office lock files
**/.~lock.*
